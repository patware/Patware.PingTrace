<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Patware.PingTrace.Adapter.RedisCache</PackageId>
    <Description>Redis ping diagnostics through a registered IConnectionMultiplexer.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="3.4.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PingTrace.Core\PingTrace.Core.csproj" />
    <ProjectReference Include="..\PingTrace.Runtime\PingTrace.Runtime.csproj" />
  </ItemGroup>

</Project>
